# Copiá este archivo como .env y cambiá solo lo que necesites.
# Docker Compose lo lee solo; sin Docker, exportá las variables antes de arrancar uvicorn.

# --- Puertos (solo Docker Compose) ---
# Puerto donde se abre la app en la compu: http://localhost:8080
FRONTEND_PORT=8080
# Puerto donde queda expuesta la API: http://localhost:8000/docs
BACKEND_PORT=8000

# --- Modelos ---
# Archivo del modelo principal. En Docker se monta en /models/best.pt y no hace falta tocarlo.
# MODEL_PATH=../best.pt
# Nombre de la versión que muestra /model/info.
MODEL_VERSION=v4
# Modelo de respaldo: se usa solo si el principal no encuentra fruta. Con "none" se apaga.
# FALLBACK_MODEL_PATH=none

# --- Umbrales de detección ---
# Confianza mínima para aceptar una fruta. Sin definir: 0.25 con CLIP y 0.5 sin CLIP.
# CONF_THRESHOLD=0.25
# Umbral propio de una fruta; pisa a CONF_THRESHOLD solo para esa fruta (mango usa 0.6 sin CLIP).
# CONF_BANANA=0.25
# CONF_MANGO=0.25
# CONF_NARANJA=0.25
# CONF_TOMATE=0.25
# Confianza mínima de una zona dañada.
DEFECT_CONF=0.25
# Superficie mínima de una fruta, como parte de la foto (0.01 = 1 %).
MIN_AREA=0.01
# Si 3 o más frutas chicas juntas cubren esta parte de la foto, se conservan (racimos de bananas).
MIN_CLUSTER=0.05
# Si la máscara llena más que esto de su recuadro, se descarta: paredes y cajas son rectángulos.
MAX_FILL=0.93
# Si una "naranja" tiene más que esta proporción de rojo, se corrige a tomate.
RED_SWAP=0.5

# --- Verificación con CLIP ---
# 1 revisa cada fruta con CLIP; 0 lo apaga. Si no puede cargar, el servidor sigue sin él.
CLIP_VERIFY=1
# Cuánto tiene que ganarle "otra cosa" a la fruta para descartarla.
CLIP_MARGIN=0.25
# Si CLIP está así de seguro de que es otra de las cuatro frutas, corrige la fruta.
CLIP_SWAP=0.6
# Máximo de recortes que revisa CLIP por foto (los más grandes).
CLIP_MAX_CROPS=6

# --- Límites y servidor ---
# Peso máximo de la foto en MB (más que esto responde 413).
MAX_UPLOAD_MB=10
# Píxeles máximos de la foto (40 millones = 40 megapíxeles).
MAX_PIXELS=40000000
# Lado máximo con el que se analiza la foto; las más grandes se achican.
MAX_SIDE=1600
# 1 hace una inferencia de prueba al arrancar para que la primera foto no tarde de más.
WARMUP=1
# Orígenes permitidos por CORS, separados por coma.
ALLOWED_ORIGINS=*
